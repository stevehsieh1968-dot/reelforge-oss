# ===================== 短影工坊 開源省錢版（reelforge-oss） =====================
# 預設設定：文案用 Gemini Flash（每支不到 NT$3），其他全部免費。

# ===== 文案 =====
# gemini：Google AI Studio 取得 https://aistudio.google.com/apikey（建議，便宜、品質好）
# openai：任何 OpenAI 相容服務，例如本機 Ollama（完全免費，但小模型寫的文案比較普通）
TEXT_PROVIDER=gemini
GEMINI_API_KEY=
# TEXT_PROVIDER=openai 時才需要：
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:8b

# ===== 配音 =====
# local：本機配音服務（先執行「啟動短影工坊.bat」會一起開）｜gemini：Gemini TTS（付費）
TTS_PROVIDER=local
# 本機配音引擎：edge（微軟台灣國語語音，免費、要網路）｜breezy（聯發科 BreezyVoice，開源，可複製說書人聲音）
TTS_ENGINE=edge
LOCAL_TTS_URL=http://127.0.0.1:5100
# BreezyVoice 安裝位置（安裝BreezyVoice.bat 預設裝在專案裡的 BreezyVoice 資料夾）
BREEZY_DIR=

# ===== 畫面 =====
# 「AI 動態」場景的畫面：
#   pixabay  Pixabay 免費實拍影片庫（推薦）
#   pexels   Pexels 免費影片庫（Pexels 目前暫停核發新金鑰，已有金鑰才能用）
#   kenburns 全部用鏡頭推移（最快、完全離線）
#   gemini   Gemini Omni 生成（付費，約 US$0.07–0.10／秒）
VIDEO_PROVIDER=pixabay
# 「AI 補圖」：pixabay／pexels（免費圖庫）｜gemini（約 US$0.034／張）｜none
IMAGE_PROVIDER=pixabay
# Pixabay 免費 API Key：到 https://pixabay.com/api/docs/ 註冊登入後，頁面上就會顯示你的 key
PIXABAY_API_KEY=
# 已經有 Pexels 金鑰才填
PEXELS_API_KEY=
# 1 = 有上傳自己圖片的場景也換成影片庫畫面（預設 0：保留你的產品圖，用鏡頭推移）
STOCK_REPLACE_UPLOADS=0

# ===== 說書人對嘴 =====
# off：說書人照片＋鏡頭推移＋配音（免費）｜gemini：Omni 真人對嘴（付費）
LIPSYNC_PROVIDER=off

# ===== 網站 =====
# 網站密碼（開放給別人用時一定要設）
ACCESS_PASSWORD=
PORT=3000
DATA_DIR=./data
# MOCK=1 可強制模擬模式（不呼叫任何服務，用來測流程）

# ===== 只有選 gemini 來源時才用到 =====
TEXT_MODEL=
TTS_MODEL=
VIDEO_MODEL=
LIPSYNC_MODEL=
VIDEO_RESOLUTION=720p
VEO_CONCURRENCY=3
VEO_PRICE_PER_SECOND=0.1
USD_TO_TWD=32.4

# ===== 影片規格與修改規則 =====
RENDER_CONCURRENCY=2
TARGET_SECONDS=180
SCENE_COUNT=10
MAX_REVISIONS=5
MAX_SCENES_PER_REVISION=4
FULL_REDO_COST=2

# 字幕字型（留白自動選：Windows 微軟正黑體／Mac 蘋方／Linux 思源黑體）
SUBTITLE_FONT=
